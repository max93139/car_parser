# Database Connection (PostgreSQL or local SQLite for testing)
# Example for PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/car_parser
# Example for SQLite: sqlite+aiosqlite:///car_parser.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/car_parser

# Telegram Bot (for sending alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Telegram Client / MTProto (for parsing telegram channels)
# Obtain from https://my.telegram.org/
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_SESSION_STRING=

# Instagram Scraper (Optional session cookie to bypass login barriers)
INSTAGRAM_SESSION_COOKIE=

# Execution Settings
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO
